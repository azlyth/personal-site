[Unit]
# Oneshot reconciler: brings the compose stack up at boot and stays "active".
# The real supervisor is Docker (restart: unless-stopped on each container).
Description=personal-site — blog + lab experiments at cloudy.nyc (docker compose)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=peter
WorkingDirectory=/home/peter/projects/personal/personal-site
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
